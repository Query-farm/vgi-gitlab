# name: test/sql/gitlab.test
# description: The gitlab worker through DuckDB, against the GitLab replay in test/mock_api (strict about query parameters)
# group: [gitlab]

require vgi

require-env GITLAB_WORKER

require-env GITLAB_MOCK_API

# Timestamps below are written in UTC.
statement ok
LOAD icu;

statement ok
SET TimeZone = 'UTC';

statement ok
ATTACH 'gitlab' (TYPE vgi, LOCATION '{GITLAB_WORKER}');

# Without a token the replay answers 401 (only the single-project route is public).
statement ok
CREATE SECRET gl_anon (TYPE gitlab, BASE_URL '{GITLAB_MOCK_API}');

statement error
SELECT count(*) FROM gitlab.main.issues('acme/widgets');
----
<REGEX>:.*HTTP 401.*

query TI
SELECT full_name, stargazers_count FROM gitlab.main.project('acme/widgets');
----
acme/widgets	42

# Lookups are blended: they take columns too, and a missing project is no row.
query TI
SELECT p.full_name, p.forks_count FROM (VALUES ('acme/widgets'), ('acme/nope')) t(path), LATERAL gitlab.main.project(t.path) p;
----
acme/widgets	7

statement ok
DROP SECRET gl_anon;

statement ok
CREATE SECRET gl (TYPE gitlab, TOKEN 'glpat-fixture', BASE_URL '{GITLAB_MOCK_API}', PER_PAGE 2);

# ---------------------------------------------------------------- namespaces

# Keyset pagination (per_page 2 => two pages, the second via a re-anchored Link header).
query TTT
SELECT full_path, visibility, html_url FROM gitlab.main.groups() ORDER BY full_path;
----
acme	public	https://gitlab.example.com/groups/acme
acme/platform	internal	https://gitlab.example.com/groups/acme/platform

query TI
SELECT full_path, parent_id FROM gitlab.main.groups(parent := 'acme');
----
acme/platform	10

# visibility pushdown
query T
SELECT full_path FROM gitlab.main.groups() WHERE visibility = 'internal';
----
acme/platform

query TTTTT
SELECT full_name, owner_login, owner_type, is_archived, is_private FROM gitlab.main.projects('acme') ORDER BY full_name;
----
acme/gadgets	acme	group	true	false
acme/platform/api	acme/platform	group	false	true
acme/widgets	acme	group	false	false

# is_archived and last_activity_at go to the API (archived=false, last_activity_after=...).
query T
SELECT full_name FROM gitlab.main.projects('acme') WHERE NOT is_archived AND last_activity_at >= TIMESTAMPTZ '2026-11-13 00:00:00+00';
----
acme/widgets

# A username: the group listing 404s, the user listing answers.
query TTT
SELECT full_name, is_fork, forked_from FROM gitlab.main.projects('alice');
----
alice/dotfiles	true	upstream/dotfiles

# NULL: your memberships (keyset pagination over /projects)
query IT
SELECT id, visibility FROM gitlab.main.projects(NULL) ORDER BY id;
----
101	public
102	internal
103	private
201	public

query TTIII
SELECT license_key, default_branch, commit_count, repository_size_bytes, open_issues_count FROM gitlab.main.project('acme/widgets');
----
mit	main	1234	5432100	3

query TTITT
SELECT source, login, access_level, access_level_name, expires_at FROM gitlab.main.members('acme/widgets') ORDER BY access_level DESC;
----
project	alice	50	owner	NULL
project	bob	40	maintainer	NULL
project	carol	30	developer	2027-01-01

query TT
SELECT source, login FROM gitlab.main.members('acme') WHERE login = 'bob';
----
group	bob

query I
SELECT count(*) FROM gitlab.main.members('acme/widgets', inherited := false);
----
1

# ---------------------------------------------------------------- issues

query ITTT
SELECT number, title, state, gitlab_state FROM gitlab.main.issues('acme/widgets', labels := 'bug') WHERE state = 'open' ORDER BY number;
----
1	Wrong total in cart	open	opened
5	Outage on checkout	open	opened

query IT
SELECT number, user_login FROM gitlab.main.issues('acme/widgets') WHERE user_login = 'alice' AND created_at >= TIMESTAMPTZ '2026-10-01 00:00:00+00' ORDER BY number;
----
2	alice
4	alice

query ITT
SELECT number, closed_by_login, closed_at FROM gitlab.main.issues('acme/widgets') WHERE state = 'closed';
----
2	bob	2026-10-03 08:00:00+00

query IIT
SELECT number, comments, milestone FROM gitlab.main.issues('acme/widgets') WHERE number IN (1, 3) ORDER BY number;
----
1	1	v1.2
3	3	NULL

query ITT
SELECT number, is_confidential, issue_type FROM gitlab.main.issues('acme/widgets') WHERE is_confidential OR issue_type = 'incident' ORDER BY number;
----
4	true	issue
5	false	incident

query T
SELECT list_sort(labels)::VARCHAR FROM gitlab.main.issues('acme/widgets') WHERE number = 1;
----
[bug, frontend]

# A group path: the project listing 404s, the group listing covers every project.
query TI
SELECT repo, count(*) FROM gitlab.main.issues('acme') WHERE state = 'open' GROUP BY repo ORDER BY repo;
----
acme/platform/api	1
acme/widgets	4

query I
SELECT count(*) FROM gitlab.main.issues('acme/widgets', search := 'cart');
----
1

query ITTT
SELECT number, user_login, is_system, body FROM gitlab.main.issue_notes('acme/widgets', 1) ORDER BY id;
----
1	bob	false	Reproduced on Firefox.
1	alice	true	changed the description

