query ITTT
SELECT number, state, gitlab_state, is_draft FROM gitlab.main.merge_requests('acme/widgets') ORDER BY number;
----
1	closed	merged	false
2	open	opened	true
3	closed	closed	false
4	closed	merged	false

query IT
SELECT number, merged_by_login FROM gitlab.main.merge_requests('acme/widgets') WHERE gitlab_state = 'merged' ORDER BY number;
----
1	bob
4	bob

query IR
SELECT count(*), median(date_diff('hour', created_at, merged_at)) FROM gitlab.main.merge_requests('acme/widgets') WHERE merged_at IS NOT NULL;
----
2	42.0

query ITT
SELECT number, head_ref, base_ref FROM gitlab.main.merge_requests('acme/widgets') WHERE head_ref = 'feature/dark-mode' AND base_ref = 'main' AND is_draft;
----
2	feature/dark-mode	main

query IT
SELECT number, requested_reviewers::VARCHAR FROM gitlab.main.merge_requests('acme/widgets') WHERE state = 'open' AND user_login = 'bob';
----
2	[carol]

query I
SELECT count(*) FROM gitlab.main.merge_requests('acme/widgets') WHERE updated_at > TIMESTAMPTZ '2026-11-12 08:00:00+00';
----
1

query TTT
SELECT user_login, is_resolvable, is_resolved FROM gitlab.main.merge_request_notes('acme/widgets', 1) WHERE NOT is_system ORDER BY created_at;
----
carol	true	true
alice	false	NULL

query TIIT
SELECT is_approved, approvals_required, approvals_left, approved_by::VARCHAR FROM gitlab.main.merge_request_approvals('acme/widgets', 1);
----
true	1	0	[carol]

query TTIIT
SELECT new_path, is_new_file, additions, deletions, is_too_large FROM gitlab.main.merge_request_diff_stats('acme/widgets', 1) ORDER BY new_path;
----
app/cart.rb	false	2	1	false
spec/cart_spec.rb	true	3	0	false
vendor/big.min.js	false	NULL	NULL	true

# LATERAL across merge requests
query II
SELECT m.number, a.approvals_left FROM gitlab.main.merge_requests('acme/widgets') m, LATERAL gitlab.main.merge_request_approvals(m.repo, m.number) a WHERE m.number = 1;
----
1	0

# ---------------------------------------------------------- repository

query TTT
SELECT short_sha, title, author_name FROM gitlab.main.commits('acme/widgets') ORDER BY committer_date DESC LIMIT 2;
----
eeeeeeee	Merge branch 'perf/search'	Bob Builder
dddddddd	Speed up search	Carol Danvers

# committer_date range => since/until
query T
SELECT title FROM gitlab.main.commits('acme/widgets') WHERE committer_date >= TIMESTAMPTZ '2026-11-01 00:00:00+00' AND committer_date < TIMESTAMPTZ '2026-11-12 00:00:00+00' ORDER BY committer_date;
----
Fix cart total
Speed up search

query TII
SELECT title, additions, deletions FROM gitlab.main.commits('acme/widgets', path := 'README.md', with_stats := true);
----
Add README	40	0

query TI
SELECT title, additions FROM gitlab.main.commits('acme/widgets', ref := 'perf/search') WHERE author_name = 'Alice Liddell' ORDER BY committer_date;
----
Initial commit	NULL
Add README	NULL

query I
SELECT len(parent_shas) FROM gitlab.main.commits('acme/widgets', since := '2026-11-12T00:00:00Z');
----
2

