41	1	production	failed	deploy:production	5001
43	3	production	success	deploy:production	5004

query I
SELECT id FROM gitlab.main.deployments('acme/widgets') WHERE status = 'success' AND updated_at >= TIMESTAMPTZ '2026-11-12 02:45:00+00';
