# ---------------------------------------------------------- CI

# List columns only: no per-pipeline detail requests.
query ITTT
SELECT id, status, source, ref FROM gitlab.main.pipelines('acme/widgets') ORDER BY id;
----
5001	success	api	main
5002	failed	push	main
5003	canceled	push	perf/search
5004	success	schedule	main
5005	running	merge_request_event	feature/dark-mode
5006	manual	web	main

# status / ref pushdown, plus detail columns (one GET /pipelines/:id each).
query ITRRT
SELECT id, user_login, duration_seconds, queued_duration_seconds, finished_at FROM gitlab.main.pipelines('acme/widgets') WHERE status = 'success' AND ref = 'main' ORDER BY id;
----
5001	bob	595.0	5.0	2026-10-01 09:11:00+00
5004	alice	570.0	30.0	2026-11-12 02:10:00+00

query IT
SELECT id, name FROM gitlab.main.pipelines('acme/widgets') WHERE source = 'schedule';
----
5004	Nightly

query I
SELECT id FROM gitlab.main.pipelines('acme/widgets') WHERE status IN ('failed', 'canceled') AND updated_at >= TIMESTAMPTZ '2026-11-01 00:00:00+00' ORDER BY id;
----
5002
5003

query I
SELECT id FROM gitlab.main.pipelines('acme/widgets') WHERE user_login = 'carol';
----
5003

# A filter on a detail column the query does not select still gets its value.
query I
SELECT id FROM gitlab.main.pipelines('acme/widgets') WHERE duration_seconds > 1000;
----
5002

query ITTTR
SELECT id, name, stage, status, duration_seconds FROM gitlab.main.jobs('acme/widgets', pipeline_id := 5002) ORDER BY id;
----
9001	build	build	success	120.0
9002	lint	test	success	60.0
9003	rspec	test	failed	900.0
9004	deploy	deploy	skipped	NULL

query IT
SELECT id, failure_reason FROM gitlab.main.jobs('acme/widgets', pipeline_id := 5002, include_retried := true) WHERE name = 'rspec' ORDER BY id;
----
9000	runner_system_failure
9003	script_failure

# pipeline_id and status from WHERE (scope[] pushdown)
query IT
SELECT id, runner_description FROM gitlab.main.jobs('acme/widgets') WHERE pipeline_id = 5002 AND status = 'failed';
----
9003	shared-runner-1

# The whole project's jobs, keyset-paginated newest first.
query I
SELECT count(*) FROM gitlab.main.jobs('acme/widgets');
----
7

query T
SELECT list_sort(runner_tags)::VARCHAR FROM gitlab.main.jobs('acme/widgets') WHERE id = 9011;
----
[docker, linux]

query IT
SELECT line_number, message FROM gitlab.main.job_log('acme/widgets', 9003) WHERE message LIKE 'ERROR%' ORDER BY line_number;
----
11	ERROR: Cart#total rounds to cents (FAILED - 1)
12	ERROR: expected 1.1, got 1.0999999
15	ERROR: Job failed: exit code 1

query ITT
SELECT line_number, section, is_section_header FROM gitlab.main.job_log('acme/widgets', 9003) WHERE line_number BETWEEN 3 AND 5 ORDER BY line_number;
----
3	prepare_executor	true
4	prepare_executor	false
5	get_sources	true

# Carriage-return progress output keeps what a terminal shows.
query T
SELECT message FROM gitlab.main.job_log('acme/widgets', 9003) WHERE message LIKE 'Receiving%';
----
Receiving objects: 100% (10/10), done.

# No ANSI escapes and no section markers survive.
query I
SELECT count(*) FROM gitlab.main.job_log('acme/widgets', 9003) WHERE message LIKE '%' || chr(27) || '%' OR message LIKE '%section_%';
----
0

query TRIIT
SELECT section, duration_seconds, first_line, last_line, is_collapsed FROM gitlab.main.job_log_sections('acme/widgets', 9003) ORDER BY started_at;
----
prepare_executor	4.0	3	4	false
get_sources	6.0	5	7	true
step_script	90.0	8	13	false
cleanup_file_variables	1.0	14	14	false

query T
SELECT header FROM gitlab.main.job_log_sections('acme/widgets', 9003) WHERE section = 'step_script';
----
Executing "step_script" stage of the job script

# Timestamped runner logs: time and stream columns, '+' continuations joined.
query ITTT
SELECT line_number, timestamp, stream, message FROM gitlab.main.job_log('acme/widgets', 9011) WHERE stream = 'stderr';
----
4	2026-11-12 02:00:40+00	stderr	warning: deprecated flag --old

query TT
SELECT section, message FROM gitlab.main.job_log('acme/widgets', 9011) WHERE line_number = 5;
----
step_script	build ok

# A job that does not exist (404) yields no rows, so a LATERAL over many jobs keeps going.
query I
SELECT count(*) FROM gitlab.main.job_log('acme/widgets', 424242);
----
0

# LATERAL: the logs of every failed job of a pipeline.
query IT
SELECT j.id, l.message FROM gitlab.main.jobs('acme/widgets', pipeline_id := 5002) j, LATERAL gitlab.main.job_log(j.repo, j.id) l WHERE j.status = 'failed' AND l.message LIKE '%examples%';
----
9003	4 examples, 1 failure

# ---------------------------------------------------------- deployments

query TTTT
SELECT name, tier, state, replace(html_url, '{GITLAB_MOCK_API}', '<base_url>') FROM gitlab.main.environments('acme/widgets') WHERE state = 'available' ORDER BY name;
----
production	production	available	<base_url>/acme/widgets/-/environments/31
staging	staging	available	<base_url>/acme/widgets/-/environments/32

